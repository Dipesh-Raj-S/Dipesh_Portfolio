# Optional. A GitHub token (no scopes needed for public data) raises the API
# rate limit from 60 to 5,000 requests/hour and enables the contribution heatmap.
GITHUB_TOKEN=

# Optional. Canonical site URL used for metadata, sitemap and Open Graph.
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
